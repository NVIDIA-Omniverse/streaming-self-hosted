environments:
  default:
    values:
      - ../environments/base.yaml
      - ../environments/{{ requiredEnv "HELMFILE_ENV" }}.yaml

---

repositories:
  - name: nvcf
    url: {{ .Values.global.helm.sources.registry }}/{{ .Values.global.helm.sources.repository }}
    oci: true

helmDefaults:
  createNamespace: true
  devel: true
  timeout: 900
  wait: true
  waitForJobs: true
  diffArgs:
    - "--dry-run=server"

templates:
  dependency: &dependency
    chart: nvcf/helm-nvcf-{{`{{ .Release.Name }}`}}
    values:
      - ../global.yaml.gotmpl
      - ../secrets/{{ requiredEnv "HELMFILE_ENV" }}-secrets.yaml
    wait: true
    waitForJobs: true
    labels:
      release-group: dependencies

releases:

  # --- NVCF NCP Dependencies ---
  - name: nats
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-nats" "0.7.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    condition: nats.enabled # From defaults.yaml or env overrides
    namespace: nats-system
    <<: *dependency # Inherits base values from the dependency template

  - name: cert-manager
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-cert-manager" "0.1.0" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    condition: certManager.enabled
    namespace: cert-manager
    <<: *dependency

  - name: openbao-server # this name MUST not change
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-openbao-server" "0.30.25" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    condition: openbao.enabled # From defaults.yaml or env overrides
    namespace: vault-system
    <<: *dependency # Inherits base values from the dependency template
    needs:
      - nats-system/nats

  - name: cassandra
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-cassandra" "0.18.0" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    condition: cassandra.enabled # From defaults.yaml or env overrides
    namespace: cassandra-system
    <<: *dependency # Inherits base values from the dependency template
