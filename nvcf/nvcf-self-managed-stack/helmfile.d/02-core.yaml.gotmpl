environments:
  default:
    values:
      - ../environments/base.yaml
      - ../environments/{{ requiredEnv "HELMFILE_ENV" }}.yaml

---

{{- $helmSourceURL := dig "global" "helm" "sources" "url" "" .Values }}
{{- if and $helmSourceURL (not (hasPrefix "https://" $helmSourceURL)) }}
{{- fail "global.helm.sources.url must use https://" }}
{{- end }}

repositories:
  - name: nvcf
{{- if $helmSourceURL }}
    url: {{ $helmSourceURL | quote }}
    {{- if dig "global" "helm" "sources" "username" "" .Values }}
    username: {{ dig "global" "helm" "sources" "username" "" .Values | quote }}
    {{- end }}
    {{- if dig "global" "helm" "sources" "password" "" .Values }}
    password: {{ dig "global" "helm" "sources" "password" "" .Values | quote }}
    {{- end }}
{{- else }}
    url: {{ .Values.global.helm.sources.registry }}/{{ .Values.global.helm.sources.repository }}
    oci: true
{{- end }}


helmDefaults:
  createNamespace: true
  devel: true
  timeout: 900
  wait: true
  waitForJobs: true
  diffArgs:
    - "--dry-run=server"

templates:
  service: &service
    chart: nvcf/helm-nvcf-{{`{{ .Release.Name }}`}}
    values:
      - ../global.yaml.gotmpl
      - ../secrets/{{ requiredEnv "HELMFILE_ENV" }}-secrets.yaml
    labels:
      release-group: services

releases:

  # NOTE: every release below depends on cassandra-system/cassandra, and
  # nats-auth-callout-service depends on nats-system/nats, both defined in
  # 01-dependencies.yaml.gotmpl. Those edges are already enforced by the
  # 01-dependencies -> 02-core stage boundary (helmfile.d/*.yaml.gotmpl files
  # run sequentially under the pinned helmfile v1.1.x), so they are
  # intentionally not repeated as needs: entries here. Only edges between
  # releases within this same file are listed explicitly. The same applies to
  # function-autoscaler in 03-observability.yaml.gotmpl, which depends on
  # cassandra-system/cassandra and nvcf/api via the 02-core -> 03-observability
  # stage boundary.

  # --- NVCF Services ---
  - name: api-keys
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-api-keys" "1.8.2" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: api-keys
    inherit:
      - template: service

  - name: sis
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-sis" "2.4.2" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: sis
    inherit:
      - template: service
    condition: icms.enabled

  - name: api
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-api" "1.27.5" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    inherit:
      - template: service
    needs:
      # Required deployment order: API Keys, ICMS/SIS, Notary, and Helm ReVal
      # must be up before Cloud Functions (this release), which registers an
      # OAuth client and base URL with each at startup. Cassandra and NATS
      # prerequisites are already enforced by the stage boundary between
      # 01-dependencies.yaml.gotmpl and this file, so they are not repeated
      # here.
      - api-keys/api-keys
      {{- if dig "icms" "enabled" true .Values }}
      - sis/sis
      {{- end }}
      # not needed to start, but needed for bootstrapping account which is done with a script in the api helm chart
      - ess/ess-api
      - nvcf/notary-service
      - nvcf/reval

  - name: nvct-api
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-nvct-api" "1.6.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    inherit:
      - template: service
    needs:
      # Required deployment order: Cloud Tasks (this release) registers an
      # OAuth client and base URL with API Keys, ICMS/SIS, ESS, Notary, and
      # Helm ReVal, and separately depends on Cloud Functions per the Cloud
      # Functions -> Cloud Tasks edge. Cassandra prerequisite is already
      # enforced by the 01-dependencies stage boundary.
      - api-keys/api-keys
      {{- if dig "icms" "enabled" true .Values }}
      - sis/sis
      {{- end }}
      - ess/ess-api
      - nvcf/notary-service
      - nvcf/reval
      - nvcf/api

  - name: invocation-service
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-invocation-service" "1.6.2" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    inherit:
      - template: service
    needs:
      - nvcf/api

  - name: grpc-proxy
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-grpc-proxy" "1.7.4" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    inherit:
      - template: service
    needs:
      - nvcf/api

  - name: ratelimiter
    chart: nvcf/helm-nvcf-rate-limiter
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-rate-limiter" "1.2.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    condition: rateLimiter.enabled
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services
    needs:
      - nvcf/api

  - name: ess-api
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-ess-api" "1.8.3" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: ess
    inherit:
      - template: service

  - name: notary-service
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-notary-service" "1.6.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    inherit:
      - template: service

  - name: admin-issuer-proxy
    chart: nvcf/helm-admin-token-issuer-proxy
    version: {{ dig "nvcf-self-managed-stack" "helm-admin-token-issuer-proxy" "1.5.3" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: api-keys
    values:
      - ../global.yaml.gotmpl
    # Finding #22 (E2E 2026-04-20): admin-issuer-proxy was not installed by
    # the first make install. helmfile list showed INSTALLED=true but
    # helm list -A confirmed no release existed.
    #
    # Root cause: helmfile 1.1.9 processes releases layer-by-layer rather
    # than strictly DAG-aware. With needs: api-keys/api-keys, this release
    # was in DAG layer 2, waiting for ALL layer-1 peers to finish, not just
    # api-keys. On a clean k3d cluster the sis release in layer 1 can spend
    # up to 15 minutes stuck on multi-node sideload races before helmfile
    # aborts the sync; when sis fails (or the run is interrupted), layer 2
    # releases are silently skipped even though their specific dependency
    # (api-keys) completed successfully.
    #
    # Fix: drop the needs on api-keys/api-keys. The proxy does not require
    # api-keys to be running at install time. The api-keys namespace is
    # auto-created by helmDefaults.createNamespace=true, and api-keys is
    # only a runtime callee (serviceMetadataURL); runtime readiness is
    # handled by the pod readinessProbe, not install ordering. With no
    # needs, admin-issuer-proxy installs in DAG layer 1 in parallel with
    # api-keys/sis/ess-api and is immune to sibling flakes.
    #
    # Also add a release-group label so the release is consistent with its
    # peers (all other services in this file carry release-group: services).
    labels:
      release-group: services

  - name: reval
    chart: nvcf/helm-reval
    version: {{ dig "nvcf-self-managed-stack" "helm-reval" "1.4.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services

  - name: nats-auth-callout-service
    chart: nvcf/helm-nvcf-nats-auth-callout-service
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-nats-auth-callout-service" "1.2.1" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nats-system
    values:
      - ../global.yaml.gotmpl
      - image:
          repository: {{ .Values.global.image.registry }}/{{ .Values.global.image.repository }}/nvcf-nats-auth-callout-service
          {{- with dig "natsAuthCalloutService" "image" "tag" "" .Values }}
          tag: {{ . | quote }}
          {{- end }}
      - serviceConfig:
          service:
            nats_url: "nats://nats.nats-system.svc.cluster.local:4222"
      - servicePluginConfigSecret:
          enabled: true
          name: nats-nkeys
          key: auth-callout-plugin.yaml
          mountPath: /etc/plugin-config/plugin.yaml
      - extraEnvs:
          - name: NVCF_NATS_AUTH_CALLOUT_SERVICE_SERVICE_NKEY__SEED
            valueFrom:
              secretKeyRef:
                name: {{ dig "nats" "authCallout" "secretName" "nats-auth-callout-nkeys" .Values | quote }}
                key: nkey_seed
          - name: NVCF_NATS_AUTH_CALLOUT_SERVICE_SERVICE_NKEY__SIGNATURE
            valueFrom:
              secretKeyRef:
                name: {{ dig "nats" "authCallout" "secretName" "nats-auth-callout-nkeys" .Values | quote }}
                key: nkey_signature
      {{- if .Values.global.imagePullSecrets }}
      - imagePullSecrets:
          {{- toYaml .Values.global.imagePullSecrets | nindent 10 }}
      {{- end }}
    labels:
      release-group: services

  - name: llm-request-router
    {{- $llmRequestRouterChartPath := dig "addons" "llm" "requestRouter" "chartPath" "" .Values }}
    chart: {{ $llmRequestRouterChartPath | default "nvcf/helm-nvcf-llm-request-router" | quote }}
    {{- if not $llmRequestRouterChartPath }}
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-llm-request-router" "1.14.3" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    {{- end }}
    namespace: nvcf
    condition: addons.llm.enabled
    values:
      - ../global.yaml.gotmpl
    needs:
      - nvcf/api
    labels:
      release-group: services

  - name: llm-api-gateway
    chart: nvcf/helm-nvcf-llm-api-gateway
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-llm-api-gateway" "1.4.3" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    condition: addons.llm.enabled
    values:
      - ../global.yaml.gotmpl
    needs:
      - nvcf/llm-request-router
    labels:
      release-group: services

  - name: vanity-gateway
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-vanity-gateway" "0.5.0" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf
    condition: addons.vanityGateway.enabled
    inherit:
      - template: service
    needs:
      - nvcf/invocation-service
    labels:
      release-group: services

  - name: nvcf-ui
    chart: nvcf/helm-nvcf-ui
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-ui" "1.1.4" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    namespace: nvcf-ui
    condition: addons.nvcfUi.enabled
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services

  # --- Gateway API Ingress ---
  - name: ingress
    {{- $gatewayRoutesChartPath := dig "ingress" "gatewayApi" "chartPath" "" .Values }}
    chart: {{ $gatewayRoutesChartPath | default "nvcf/nvcf-gateway-routes" | quote }}
    {{- if not $gatewayRoutesChartPath }}
    version: {{ dig "nvcf-self-managed-stack" "helm-nvcf-gateway-routes" "1.18.3" (readFile "../../../image-manifest/manifest.yaml" | fromYaml) }}
    {{- end }}
    needs:
      - nvcf/notary-service
      - api-keys/api-keys
      {{- if dig "addons" "nvcfUi" "enabled" false .Values }}
      - nvcf-ui/nvcf-ui
      {{- end }}
    namespace: {{ .Values.ingress.gatewayApi.controllerNamespace }}
    condition: ingress.gatewayApi.enabled
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: ingress
